{
  "name": "bohack-ttc",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "copy:pdf-assets": "node scripts/copy-pdf-assets.mjs",
    "predev": "npm run copy:pdf-assets",
    "predev:web": "npm run copy:pdf-assets",
    "prebuild": "npm run copy:pdf-assets",
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:web\"",
    "dev:web": "vite --host 127.0.0.1",
    "dev:server": "tsx watch server/index.ts",
    "build": "tsc -b && vite build",
    "test": "tsx --test server/research/*.test.ts server/web-search.test.ts server/analysis.test.ts shared/*.test.ts",
    "start": "tsx server/index.ts",
    "import:competitions": "node scripts/import-competitions.mjs",
    "import:papers": "tsx scripts/import-papers.ts"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "lucide-react": "^0.468.0",
    "openai": "^4.77.0",
    "pdfjs-dist": "^4.10.38",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "tsx": "^4.19.2",
    "typescript": "~5.7.2",
    "vite": "^6.0.7"
  }
}
